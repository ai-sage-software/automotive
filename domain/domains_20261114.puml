' Illustrative cross-context interactions; validate ownership and direction with domain SMEs.
AR_party_identity_customer ..> AR_service_service_appointment : schedules
AR_party_identity_party ..> AR_finance_invoice : billing party
AR_vehicle_asset_mgt_vehicle ..> AR_service_repair_order : serviced vehicle
AR_vehicle_asset_mgt_vehicle ..> AR_logistics_fulfillment_vehicle_transfer_order : transferred asset
AR_inventory_inventory_vehicle ..> AR_sales_operations_vehicle_invoice : sold inventory
AR_sales_operations_retail_delivery_report ..> AR_sales_operations_vehicle_invoice : reports delivery
AR_service_repair_order ..> AR_inventory_part_inventory : checks stock
AR_parts_part_order ..> AR_logistics_fulfillment_part_shipment : fulfillment
AR_logistics_fulfillment_vehicle_transfer_order ..> AR_logistics_fulfillment_vehicle_transport_session : transport execution
AR_logistics_fulfillment_vehicle_transport_session ..> AR_logistics_fulfillment_vehicle_trip : trip execution
AR_parts_part_invoice ..> AR_payment_payment : settlement
AR_service_service_invoice ..> AR_payment_payment : settlement
AR_sales_operations_vehicle_invoice ..> AR_payment_payment : settlement
AR_payment_payment ..> AR_payment_payment_event : emits lifecycle events
AR_payment_payment ..> AR_payment_receipt : records payment
AR_payment_payment ..> AR_finance_journal_entry_transaction : accounting posting
AR_finance_invoice ..> AR_finance_journal_entry_transaction : accounting posting
AR_marketing_loyalty_reward ..> AR_marketing_loyalty_loyalty_account : loyalty application
AR_pricing_incentives_discount ..> AR_pricing_incentives_price_plan : pricing policy
AR_taxes_tax ..> AR_finance_invoice : tax assessment
AR_marketing_loyalty_marketing_campaign ..> AR_marketing_loyalty_customer_segment : targets audience
AR_human_resources_payroll_run ..> AR_human_resources_payroll_stub : produces pay statements
AR_telematics_connected_vehicle_connected_vehicle ..> AR_telematics_connected_vehicle_vehicle_telemetry_event : produces telemetry

