@startuml CounterSaleStateDiagram

skinparam titleFontSize 20
skinparam state {
    BackgroundColor<<Initial>> AliceBlue
    BackgroundColor<<Processing>> LightGoldenRodYellow
    BackgroundColor<<Success>> LightGreen
    BackgroundColor<<Failure>> LightCoral
    BackgroundColor<<Neutral>> WhiteSmoke
    BorderColor Gray
}

title Counter Sale (Immediate Payment) - Intent-Driven Flow

' Define the starting point
[*] --> CREATED

' 1. Transaction Creation & Initiation
state CREATED <<Initial>> : Order/Ticket is opened

' 2. Payment Attempt (Immediate)
state PENDING <<Processing>>
state PROCESSING <<Processing>>
state REQUIRES_ACTION <<Processing>> : Pin Pad / Signature

CREATED --> PENDING : Payment method selected
PENDING --> PROCESSING : Sending request
PROCESSING --> REQUIRES_ACTION : User input needed
REQUIRES_ACTION --> PROCESSING : Input received

' 3. Authorization Gates
state APPROVED <<Success>>
state PAID <<Success>> : Funds captured
state SUCCEEDED <<Success>>
state COMPLETED <<Success>>

PROCESSING --> APPROVED : Auth granted
APPROVED --> PAID : Instant capture
PAID --> SUCCEEDED : Success confirmed
SUCCEEDED --> COMPLETED : Finalized

' 4. Failure & Reversal States
state FAILED <<Failure>>
state DENIED <<Failure>>
state REJECTED <<Failure>>
state VOIDED <<Neutral>>
state REFUNDED <<Neutral>>

PROCESSING --> FAILED : Error
PROCESSING --> DENIED : Card denied
PROCESSING --> REJECTED : Risk rejection

' 5. Post-Completion Actions
PAID --> VOIDED : Immediate void
PAID --> REFUNDED : Subsequent return

' 6. Terminal End States
FAILED --> [*]
DENIED --> [*]
REJECTED --> [*]
VOIDED --> [*]
REFUNDED --> [*]
COMPLETED --> [*]

@enduml